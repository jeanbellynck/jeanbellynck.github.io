@article{bassoBriefDailyMeditation2019,
  title = {Brief, Daily Meditation Enhances Attention, Memory, Mood, and Emotional Regulation in Non-Experienced Meditators},
  author = {Basso, Julia C. and McHale, Alexandra and Ende, Victoria and Oberlin, Douglas J. and Suzuki, Wendy A.},
  date = {2019-01-01},
  journaltitle = {Behavioural Brain Research},
  shortjournal = {Behav Brain Res},
  volume = {356},
  eprint = {30153464},
  eprinttype = {pmid},
  pages = {208--220},
  issn = {1872-7549},
  doi = {10.1016/j.bbr.2018.08.023},
  abstract = {Meditation is an ancient practice that cultivates a calm yet focused mind; however, little is known about how short, practical meditation practices affect cognitive functioning in meditation-naïve populations. To address this question, we randomized subjects (ages of 18-45) who were non-experienced meditators into either a 13-min daily guided meditation session or a 13-min daily podcast listening session (control group) for a total duration of 8 weeks. We examined the effects of the daily meditation practice relative to podcast listening on mood, prefrontal and hippocampal functioning, baseline cortisol levels, and emotional regulation using the Trier Social Stress Test (TSST). Compared to our control group, we found that 8 but not 4 weeks of brief, daily meditation decreased negative mood state and enhanced attention, working memory, and recognition memory as well as decreased state anxiety scores on the TSST. Furthermore, we report that meditation-induced changes in emotional regulation are more strongly linked to improved affective state than improved cognition. This study not only suggests a lower limit for the duration of brief daily meditation needed to see significant benefits in non-experienced meditators, but suggests that even relatively short daily meditation practice can have similar behavioral effects as longer duration and higher-intensity mediation practices.},
  langid = {english},
  keywords = {🔥,Adolescent,Adult,Affect,Anxiety,Attention,Breathing,Cognition,Consciousness,Emotions,Executive function,Female,Humans,Male,Meditation,Memory Short-Term,Middle Aged,Mindfulness,Stress,Stress Psychological,Young Adult}
}

