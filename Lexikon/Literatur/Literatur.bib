@online{nozakiFilteredInstantonFloer2022,
  title = {Filtered Instanton {{Floer}} Homology and the Homology Cobordism Group},
  author = {Nozaki, Yuta and Sato, Kouki and Taniguchi, Masaki},
  date = {2022-01-26},
  eprint = {1905.04001},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.1905.04001},
  url = {http://arxiv.org/abs/1905.04001},
  urldate = {2023-12-04},
  abstract = {For any \$s \textbackslash in [-\textbackslash infty, 0] \$ and oriented homology 3-sphere \$Y\$, we introduce a homology cobordism invariant \$r\_s(Y)\textbackslash in (0,\textbackslash infty]\$. The values \$\textbackslash\{r\_s(Y)\textbackslash\}\$ are included in the critical values of the \$SU(2)\$-Chern-Simons functional of \$Y\$, and we show a negative definite cobordism inequality and a connected sum formula for \$r\_s\$. As applications, we obtain several new results on the homology cobordism group. First, we give infinitely many homology 3-spheres which cannot bound any definite 4-manifold. Next, we show that if the 1-surgery of \$S\textasciicircum 3\$ along a knot has the Fr\{\textbackslash o\}yshov invariant negative, then all positive \$1/n\$-surgeries along the knot are linearly independent in the homology cobordism group. In another direction, we use \$\textbackslash\{r\_s\textbackslash\}\$ to define a filtration on the homology cobordism group which is parametrized by \$[0,\textbackslash infty]\$. Moreover, we compute an approximate value of \$r\_s\$ for the hyperbolic 3-manifold obtained by \$1/2\$-surgery along the mirror of the knot \$5\_2\$.},
  pubstate = {prepublished},
  keywords = {Mathematics - Differential Geometry,Mathematics - Geometric Topology},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/2RMMIEIR/Nozaki et al. - 2022 - Filtered instanton Floer homology and the homology.pdf;/home/jean/snap/zotero-snap/common/Zotero/storage/X4RRSKLA/1905.html}
}

