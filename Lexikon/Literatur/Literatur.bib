  url = {http://arxiv.org/abs/2312.11258},
  urldate = {2024-02-14},
  abstract = {We study the freeness problem for subgroups of \$\textbackslash operatorname\{SL\}\_2(\textbackslash mathbb\{C\})\$ generated by two parabolic matrices. For \$q = r/p \textbackslash in \textbackslash mathbb\{Q\} \textbackslash cap (0,4)\$, where \$p\$ is prime and \$\textbackslash gcd(r,p)=1\$, we initiate the study of the algebraic structure of the group \$\textbackslash Delta\_q\$ generated by the two matrices \textbackslash [ A = \textbackslash begin\{pmatrix\} 1 \& 0 \textbackslash\textbackslash{} 1 \& 1 \textbackslash end\{pmatrix\}, \textbackslash text\{ and \} Q\_q = \textbackslash begin\{pmatrix\} 1 \& q \textbackslash\textbackslash{} 0 \& 1 \textbackslash end\{pmatrix\}. \textbackslash ] We introduce the conjecture that \$\textbackslash Delta\_\{r/p\} = \textbackslash overline\{\textbackslash Gamma\}\_1\textasciicircum\{(p)\}(r)\$, the congruence subgroup of \$\textbackslash operatorname\{SL\}\_2(\textbackslash mathbb\{Z\}[\textbackslash frac\{1\}\{p\}])\$ consisting of all matrices with upper right entry congruent to \$0\$ mod \$r\$ and diagonal entries congruent to \$1\$ mod \$r\$. We prove this conjecture when \$r \textbackslash leq 4\$ and for some cases when \$r = 5\$. Furthermore, conditional on a strong form of Artin's conjecture on primitive roots, we also prove the conjecture when \$r \textbackslash in \textbackslash\{ p-1, p+1, (p+1)/2 \textbackslash\}\$. In all these cases, this gives information about the algebraic structure of \$\textbackslash Delta\_\{r/p\}\$: it is isomorphic to the fundamental group of a finite graph of virtually free groups, and has finite index \$J\_2(r)\$ in \$\textbackslash operatorname\{SL\}\_2(\textbackslash mathbb\{Z\}[\textbackslash frac\{1\}\{p\}])\$, where \$J\_2(r)\$ denotes the Jordan totient function.},
  pubstate = {prepublished},
  keywords = {🔥,30F35 30F40 (Primary) 20E05 11J70 (Secondary),Mathematics - Group Theory,Mathematics - Number Theory},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/ZEK9ZTRR/Nyberg-Brodda - 2024 - On congruence subgroups of $operatorname SL _2(m.pdf;/home/jean/snap/zotero-snap/common/Zotero/storage/T4HCUPKQ/2312.html}
}

