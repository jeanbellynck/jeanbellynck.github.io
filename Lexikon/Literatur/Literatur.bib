@inproceedings{juhaszExamplesTopologicallyUnknotted2023,
  title = {Examples of Topologically Unknotted Tori},
  author = {Juh'asz, Andr'as P. and Powell, Mark},
  date = {2023-12-11},
  url = {https://www.semanticscholar.org/paper/Examples-of-topologically-unknotted-tori-Juh'asz-Powell/793db2bed6390d8e43e82869f00d67bf2b83a37e},
  urldate = {2024-05-23},
  abstract = {We show that certain smooth tori with group \$\textbackslash mathbb\{Z\}\$ in \$S\textasciicircum 4\$ have exteriors with standard equivariant intersection forms, and so are topologically unknotted. These include the turned 1-twist-spun tori in the 4-sphere constructed by Boyle, the union of the genus one Seifert surface of Cochran and Davis that has no slice derivative with a ribbon disc, and tori with precisely four critical points whose middle level set is a 2-component link with vanishing Alexander polynomial. This gives evidence towards the conjecture that all \$\textbackslash mathbb\{Z\}\$-surfaces in \$S\textasciicircum 4\$ are topologically unknotted, which is open for genus one and two. It is unclear whether these tori are smoothly unknotted, except for tori with four critical points whose middle level set is a split link. The double cover of \$S\textasciicircum 4\$ branched along any of these surfaces is a potentially exotic copy of \$S\textasciicircum 2 \textbackslash times S\textasciicircum 2\$, and, in the case of turned twisted tori, we show they cannot be distinguished from \$S\textasciicircum 2 \textbackslash times S\textasciicircum 2\$ using Seiberg-Witten invariants.},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/9QEQ2CMA/Juh'asz and Powell - 2023 - Examples of topologically unknotted tori.pdf}
}

