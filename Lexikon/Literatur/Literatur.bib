@online{yasuiNucleiExotic4manifolds2012,
  title = {Nuclei and Exotic 4-Manifolds},
  author = {Yasui, Kouichi},
  date = {2012-02-16},
  eprint = {1111.0620},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.1111.0620},
  url = {http://arxiv.org/abs/1111.0620},
  urldate = {2023-12-04},
  abstract = {We introduce a new generalization of Gompf nuclei and give applications. We construct infinitely many exotic smooth structures for a large class of compact 4-manifolds with boundary, regarding topological invariants. We prove that a large class of closed 3-manifolds (including disjoint unions of Stein fillable 3-manifolds) bound compact connected oriented 4-manifolds which admit infinitely many smooth structures. To detect smooth structures, we introduce a relative genus function. As a side result, we show that log transform and knot surgery of 4-manifolds do not admit any Stein structure, under a mild condition. Applying these results together with corks, we construct arbitrary many compact Stein 4-manifolds and infinitely many non-Stein 4-manifolds which are all homeomorphic but mutually non-diffeomorphic.},
  pubstate = {prepublished},
  keywords = {57R55 57R65 57R17,Mathematics - Geometric Topology,Mathematics - Symplectic Geometry},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/XGWFYU9K/Yasui - 2012 - Nuclei and exotic 4-manifolds.pdf;/home/jean/snap/zotero-snap/common/Zotero/storage/SBRXIS3D/1111.html}
}

