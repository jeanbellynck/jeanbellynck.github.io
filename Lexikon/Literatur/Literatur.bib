@online{asaoClassificationMetricFibrations2023,
  title = {Classification of Metric Fibrations},
  author = {Asao, Yasuhiko},
  date = {2023-07-10},
  eprint = {2307.04387},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.2307.04387},
  url = {http://arxiv.org/abs/2307.04387},
  urldate = {2023-12-06},
  abstract = {In this paper, we study `a fibration of metric spaces' that was originally introduced by Leinster in the study of the magnitude and called metric fibrations. He showed that the magnitude of a metric fibration splits into the product of those of the fiber and the base, which is analogous to the Euler characteristic and topological fiber bundles. His idea and our approach is based on Lawvere's suggestion of viewing a metric space as an enriched category. Actually, the metric fibration turns out to be the restriction of the enriched Grothendieck fibrations to metric spaces. We give a complete classification of metric fibrations by several means, which is parallel to that of topological fiber bundles. That is, the classification of metric fibrations is reduced to that of `principal fibrations', which is done by the `1-Cech cohomology' in an appropriate sense. Here we introduce the notion of torsors in the category of metric spaces, and the discussions are analogous to the sheaf theory. Further, we can define the `fundamental group \$\textbackslash pi\textasciicircum m\_1(X)\$' of a metric space \$X\$, which is a group object in metric spaces, such that the conjugation classes of homomorphisms \$Hom(\textbackslash pi\textasciicircum m\_1(X), G)\$ corresponds to the isomorphism classes of `principal \$G\$-fibrations' over \$X\$. Namely, it is classified like topological covering spaces.},
  pubstate = {prepublished},
  keywords = {Mathematics - Algebraic Topology,Mathematics - Category Theory,Mathematics - Metric Geometry},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/XQR5D4UW/Asao - 2023 - Classification of metric fibrations.pdf;/home/jean/snap/zotero-snap/common/Zotero/storage/UW7X8UGW/2307.html}
}

@online{asaoMagnitudeHomologyPath2022,
  title = {Magnitude Homology and {{Path}} Homology},
  author = {Asao, Yasuhiko},
  date = {2022-01-20},
  url = {https://arxiv.org/abs/2201.08047v3},
  urldate = {2023-12-04},
  abstract = {In this article, we show that magnitude homology and path homology are closely related, and we give some applications. We define differentials \$\{\textbackslash mathrm MH\}\textasciicircum\{\textbackslash ell\}\_k(G) \textbackslash longrightarrow \{\textbackslash mathrm MH\}\textasciicircum\{\textbackslash ell-1\}\_\{k-1\}(G)\$ between magnitude homologies of a digraph \$G\$, which make them chain complexes. Then we show that its homology \$\{\textbackslash mathcal MH\}\textasciicircum\{\textbackslash ell\}\_k(G)\$ is non-trivial and homotopy invariant in the context of `homotopy theory of digraphs' developed by Grigor'yan--Muranov--S.-T. Yau et al (G-M-Ys in the following). It is remarkable that the diagonal part of our homology \$\{\textbackslash mathcal MH\}\textasciicircum\{k\}\_k(G)\$ is isomorphic to the reduced path homology \$\textbackslash tilde\{H\}\_k(G)\$ also introduced by G-M-Ys. Further, we construct a spectral sequence whose first page is isomorphic to magnitude homology \$\{\textbackslash mathrm MH\}\textasciicircum\{\textbackslash ell\}\_k(G)\$, and the second page is isomorphic to our homology \$\{\textbackslash mathcal MH\}\textasciicircum\{\textbackslash ell\}\_k(G)\$. As an application, we show that the diagonality of magnitude homology implies triviality of reduced path homology. We also show that \$\textbackslash tilde\{H\}\_k(g) = 0\$ for \$k \textbackslash geq 2\$ and \$\textbackslash tilde\{H\}\_1(g) \textbackslash neq 0\$ if any edges of an undirected graph \$g\$ is contained in a cycle of length \$\textbackslash geq 5\$.},
  langid = {english},
  organization = {arXiv.org},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/Y7NS3FC3/Asao - 2022 - Magnitude homology and Path homology.pdf}
}

