@online{nyberg-broddaCongruenceSubgroups$operatornameSL_2mathbbZfrac1p$2024,
  title = {On Congruence Subgroups of \$\textbackslash operatorname\{\vphantom\}{{SL}}\vphantom\{\}\_2(\textbackslash mathbb\{\vphantom\}{{Z}}\vphantom\{\}[\textbackslash frac\{1\}\{p\}])\$ Generated by Two Parabolic Elements},
  author = {Nyberg-Brodda, Carl-Fredrik},
