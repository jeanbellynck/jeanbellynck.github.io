@inproceedings{eudave-munozForbiddenComplexes3sphere2024,
  title = {Forbidden Complexes for the 3-Sphere},
  author = {Eudave-muñoz, M. and Ozawa, Makoto},
  date = {2024-03-27},
  url = {https://www.semanticscholar.org/paper/Forbidden-complexes-for-the-3-sphere-Eudave-mu%C3%B1oz-Ozawa/b2047e6182c4e217f8a260eb6b73fb4fbf344a75},
  urldate = {2024-05-23},
  abstract = {A simplicial complex is said to be \{\textbackslash em critical\} (or \{\textbackslash em forbidden\}) for the 3-sphere \$S\textasciicircum 3\$ if it cannot be embedded in \$S\textasciicircum 3\$ but after removing any one point, it can be embedded. We show that if a multibranched surface cannot be embedded in \$S\textasciicircum 3\$, it contains a critical complex which is a union of a multibranched surface and a (possibly empty) graph. We exhibit all critical complexes for \$S\textasciicircum 3\$ which are contained in \$K\_5 \textbackslash times S\textasciicircum 1\$ and \$K\_\{3,3\} \textbackslash times S\textasciicircum 1\$ families. We also classify all critical complexes for \$S\textasciicircum 3\$ which can be decomposed into \$G\textbackslash times S\textasciicircum 1\$ and \$H\$, where \$G\$ and \$H\$ are graphs. In spite of the above property, there exist complexes which cannot be embedded in \$S\textasciicircum 3\$, but they do not contain any critical complexes. From the property of those examples, we define an equivalence relation on all simplicial complexes \$\textbackslash mathcal\{C\}\$ and a partially ordered set of complexes \$(\textbackslash mathcal\{C\}/\textbackslash mathord\textbackslash sim; \textbackslash subseteqq)\$, and refine the definition of critical. According to the refined definition of critical, we show that if a complex \$X\$ cannot be embedded in \$S\textasciicircum 3\$, then there exists \$[X']\textbackslash subseteqq [X]\$ such that \$[X']\$ is critical for \$[S\textasciicircum 3]\$.},
  file = {/home/jean/snap/zotero-snap/common/Zotero/storage/QWXQXMFT/Eudave-muñoz and Ozawa - 2024 - Forbidden complexes for the 3-sphere.pdf}
}

